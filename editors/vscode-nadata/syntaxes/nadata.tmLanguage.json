{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Nadata",
	"scopeName": "source.nadata",
	"patterns": [
		{
			"include": "#block-comment"
		},
		{
			"include": "#line-comment"
		},
		{
			"include": "#string"
		},
		{
			"include": "#boolean"
		},
		{
			"include": "#self"
		},
		{
			"include": "#class-declaration"
		},
		{
			"include": "#function-declaration"
		},
		{
			"include": "#method-declaration"
		},
		{
			"include": "#const-keyword"
		},
		{
			"include": "#builtin-function-call"
		},
		{
			"include": "#builtin-method-call"
		},
		{
			"include": "#member-call"
		},
		{
			"include": "#member-access"
		},
		{
			"include": "#parameter"
		},
		{
			"include": "#logical-operators"
		},
		{
			"include": "#control-keywords"
		},
		{
			"include": "#builtin-types"
		},
		{
			"include": "#call"
		},
		{
			"include": "#user-types"
		},
		{
			"include": "#numeric"
		},
		{
			"include": "#statement-separator"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"block-comment": {
			"name": "comment.block.nadata",
			"begin": "\"\"\"",
			"end": "\"\"\"",
			"patterns": []
		},
		"line-comment": {
			"name": "comment.line.number-sign.nadata",
			"match": "#.*$"
		},
		"string": {
			"name": "string.quoted.double.nadata",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.nadata",
					"match": "\\\\(u[0-9a-fA-F]{4}|.)"
				}
			]
		},
		"boolean": {
			"name": "constant.language.boolean.nadata",
			"match": "\\b(true|false)\\b"
		},
		"self": {
			"name": "variable.language.self.nadata",
			"match": "\\bself\\b"
		},
		"class-declaration": {
			"match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?:\\(\\s*([A-Za-z_][A-Za-z0-9_]*)?\\s*\\)?)?",
			"captures": {
				"1": {
					"name": "keyword.declaration.class.nadata storage.type.class"
				},
				"2": {
					"name": "entity.name.class.nadata"
				},
				"3": {
					"name": "entity.name.class.nadata"
				}
			}
		},
		"function-declaration": {
			"match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": {
					"name": "keyword.declaration.function.nadata storage.type.function"
				},
				"2": {
					"name": "entity.name.function.nadata"
				}
			}
		},
		"method-declaration": {
			"match": "(@)\\s*([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": {
					"name": "punctuation.definition.method.nadata"
				},
				"2": {
					"name": "entity.name.function.nadata"
				}
			}
		},
		"const-keyword": {
			"name": "keyword.declaration.const.nadata storage.modifier.const",
			"match": "\\b(const)\\b"
		},
		"builtin-function-call": {
			"name": "support.function.builtin.nadata",
			"match": "\\b(print|zeros|fill|eye|randn|arange|sin|cos|abs|exp|sqrt|log|pow|backward|set_learnable|set_trackable|detach|array_to_tensor|tensor_to_array|get_batch_of_partition|get_partition_iteration_count|SGD)(?=\\s*\\()"
		},
		"builtin-method-call": {
			"name": "support.function.builtin.nadata",
			"match": "(?<=\\.)\\b(keys|values|push|pop|peek|add|discard|at|set_at|has|remove|size|shape|coords|neighbors|occupied_neighbors|length|now|sum|min|max|transpose|fill|map|mean|argmax|argmin|matmul|concat|reshape|flatten|gather|topk|to_float|to_int|permute|conv1d|conv2d|max_pool|min_pool|avg_pool|relu|grad)(?=\\s*\\()"
		},
		"member-call": {
			"name": "entity.name.function.call.nadata",
			"match": "(?<=\\.)\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
		},
		"member-access": {
			"name": "variable.other.member.nadata",
			"match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
		},
		"parameter": {
			"name": "variable.parameter.nadata",
			"match": "(?<=\\(|,)\\s*([a-z_][A-Za-z0-9_]*)\\s*(?=\\s*[:=])",
			"captures": {
				"1": {
					"name": "variable.parameter.nadata"
				}
			}
		},
		"logical-operators": {
			"name": "keyword.operator.logical.nadata",
			"match": "\\b(and|or|not)\\b"
		},
		"control-keywords": {
			"name": "keyword.control.nadata",
			"match": "\\b(if|elif|else|for|in|while|return|break|continue|pass)\\b"
		},
		"builtin-types": {
			"name": "support.type.nadata",
			"match": "\\b(Array|Dict|Set|Queue|PriorityQueue|Tensor|GridSquare2D|GridHex2D|GridCube3D|DateTime|Color|Str|Bool|BFloat16|UBFloat16|U?Float(?:8_E4M3|8_E5M2|16|32|64)|U?Int[0-9]+)\\b"
		},
		"call": {
			"name": "entity.name.function.call.nadata",
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
		},
		"user-types": {
			"name": "entity.name.type.nadata",
			"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
		},
		"numeric": {
			"name": "constant.numeric.nadata",
			"match": "\\b[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?\\b"
		},
		"statement-separator": {
			"name": "punctuation.separator.statement.nadata",
			"match": "::"
		},
		"operators": {
			"name": "keyword.operator.nadata",
			"match": "\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|->|[-+*/%<>=]"
		},
		"punctuation": {
			"name": "punctuation.separator.nadata",
			"match": "[{}()\\[\\];,.:@]"
		}
	}
}
