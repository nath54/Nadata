# ==============================================================================
# Example 5: Parser Edge Cases & Extreme Formatting Schema
# Tests comments, trailing commas, single-line declarations, unusual spacing.
# ==============================================================================

# Comment immediately before class
class EdgeCaseItem {
    # Inline comment and single-character identifiers
    x: Int32 = 0;
    y: Int32; # Trailing comment after semicolon

    # Multiple empty lines follow

    str_with_symbols: Str = "Hello, world! Special chars: ; { } ( ) -> = @ # //";
    empty_str: Str = "";

    # Trailing semicolon and unusual spacing around colon
    spaced_field   :   UFloat64   =   3.14159   ;


    # Empty array with explicit type
    tags: Array[Str] = [];

    # Method with no arguments and empty return
    @noop() -> Bool {
        return true;
    }

    # Method with parameters disjoint from attribute names (shadowing is
    # a resolution error): 'x' and 'y' above are attributes, so the
    # parameters must use different names
    @update_coords(new_x: Int32, new_y: Int32) -> Int32 {
        Int32 sum = new_x + new_y;
        return sum;
    }
}

# Empty class declaration without whitespace inside braces
class EmptyClass{}

# Class with inheritance on same line
class ChildOfEmpty(EmptyClass){}
