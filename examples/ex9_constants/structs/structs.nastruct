# ==============================================================================
# Example 9: Constants and Symbolic Tensor Dimensions
# Exercises `const` attributes (bind once in the constructor, immutable
# afterwards) and tensor shapes declared with symbolic dimensions that
# reference those constants. Every instance binds its own extents; the
# constructor validates payloads against the bound dims.
# Every print below is asserted by tests/test_examples.py.
# ==============================================================================

class Attention {
    # Immutable per-instance parameters: the tensor shapes below refer
    # to these names, so every tensor write is checked against them
    const batch: Int32;
    const dim: Int32 = 4;

    # Derived constants: computed per instance from the bound constants
    const half: Int32 = self.dim / 2;
    const fourdim: Int32 = self.dim * 4;

    label: Str;

    # [batch, dim] matrices: the shape is validated at construction
    q: Tensor[Float32, batch, dim];
    k: Tensor[Float32, batch, dim];

    # A [half] vector: its length follows the instance's own dim
    proj: Tensor[Float32, half] = [];

    # Total a [batch, dim] argument against this instance's extents
    @match_total(x: Tensor[Float32, batch, dim]) -> Float32 {
        total: Float32 = 0.0;
        for (v: Float32 in x) { total = total + v; }
        return total;
    }

    # Total the q matrix by row-major iteration
    @q_sum() -> Float32 {
        total: Float32 = 0.0;
        for (x: Float32 in self.q) { total = total + x; }
        return total;
    }
}
