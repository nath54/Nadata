
class Entity{
    name: Str;
    gender: Str = "?";
    birthday: DateTime = DateTime();
    birthplace: Str = "";

    parents: Array[Entity] = [];
    children: Array[Entity] = [];

    @age(now: DateTime = DateTime.now()) -> DateTime {
        return now - birthday;
    }

    @older(other_entity: Entity, now: DateTime = DateTime.now()) -> Bool {
        other_entity_age: DateTime = other_entity.age(now);
        self_age: DateTime = age(now);

        if(other_entity_age >= self_age){
            return false;
        }

        return true;
    }
}

class Human(Entity){
    size: UFloat16;
    weight: UFloat16;

    pets: Array[Animal] = [];
    objects: Array[ObjectInstance] = [];
}

class Animal(Entity){}

class Cat(Animal){
    color: Color = Color(255, 255, 255);
}

class ObjectType{
    name: Str;
    description: Str = "";
}

class ObjectInstance{
    object_type: ObjectType;
    state: UFloat16 = 1.0;

    @is_broken -> Bool {

        broken: Bool = false;

        if (state <= 0){
            broken = true;
        }

        return broken;
    }
}

# --- Standalone Top-Level Functions ---

@calculate_age_difference(h1: Human, h2: Human, now: DateTime = DateTime.now()) -> DateTime {
    DateTime age1 = h1.age(now);
    DateTime age2 = h2.age(now);
    return age1 - age2;
}

@is_adult(h: Human, now: DateTime = DateTime.now()) -> Bool {
    DateTime current_age = h.age(now);
    if (current_age.year >= 18) {
        return true;
    }

    return false;
}

